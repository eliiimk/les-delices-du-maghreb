# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais committer le fichier .env (protégé par .gitignore).

# Connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/restaurant-delices

# Port du serveur (optionnel, 3000 par défaut)
PORT=3000

# Origines autorisées pour CORS, séparées par des virgules
# En développement : http://localhost:3000
# En production : ajouter le(s) domaine(s) Vercel du frontend
ALLOWED_ORIGINS=http://localhost:3000,https://votre-projet.vercel.app

# Mot de passe de l'interface d'administration (obligatoire — aucune valeur par défaut)
ADMIN_PASSWORD=

# Configuration email (nodemailer) pour les notifications de commande
EMAIL_USER=
EMAIL_PASS=
